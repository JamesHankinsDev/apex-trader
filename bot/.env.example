# ─────────────────────────────────────────────────────────────
# Apex Trader 2.0 — bot environment template
# Copy to `bot/.env` and fill in. NEVER commit the filled-in .env.
# ─────────────────────────────────────────────────────────────

# --- Alpaca credentials ---------------------------------------------------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# `paper` | `live` — see utils/env.js. Guards against accidental live trading.
TRADING_MODE=paper

# --- Grid strategy --------------------------------------------------------
# Symbol in Alpaca crypto notation.
GRID_SYMBOL=BTC/USD

# Price bounds for the grid. The bot idles when price exits this band.
GRID_LOWER_BOUND=55000
GRID_UPPER_BOUND=75000

# Number of grid levels between the bounds (inclusive of both ends).
GRID_LEVELS=20

# `arithmetic` = equal price gaps, `geometric` = equal percentage gaps.
GRID_SPACING=geometric

# Base-asset quantity submitted per level.
GRID_ORDER_SIZE=0.001

# --- Risk limits ----------------------------------------------------------
# Total quote-currency exposure the bot may hold. Refuses to exceed it.
MAX_POSITION_USD=5000

# Halt trading if realized+unrealized PnL drops below this (negative number).
MAX_DAILY_LOSS_USD=-250

# --- Runtime --------------------------------------------------------------
# Milliseconds between reconcile passes.
POLL_INTERVAL_MS=5000
LOG_LEVEL=info

# Port the dashboard API listens on.
API_PORT=4000
