# ─────────────────────────────────────────────────────────────
# Apex Trader 2.0 — bot environment template
# Copy to `bot/.env` (or `.env.local`) and fill in.
# NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# --- Alpaca credentials ---------------------------------------------------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# `paper` | `live`. Paper mode forces the paper endpoint no matter what
# ALPACA_BASE_URL says, so going live is a deliberate two-part change.
TRADING_MODE=paper

# ─────────────────────────────────────────────────────────────
# GRID SHAPE
# ─────────────────────────────────────────────────────────────

GRID_SYMBOL=BTC/USD

# Number of levels spanning the band, inclusive of both ends.
GRID_LEVELS=20

# `arithmetic` = equal dollar gaps, `geometric` = equal percentage gaps.
GRID_SPACING=geometric

# ─────────────────────────────────────────────────────────────
# RATIOS — the grid rescales itself from these.
# Bounds and order size are DERIVED from live account state at startup,
# so they grow with the account and follow price. Nothing to re-set by hand.
# ─────────────────────────────────────────────────────────────

# Half-width of the band around the anchor. 0.15 => anchor ±15%.
# Accepts "0.15" or "15%".
GRID_BAND_PCT=0.15

# Fraction of live equity the grid may deploy if EVERY level fills.
# Order size = (equity x this) / (levels x upperBound).
GRID_ALLOCATION_PCT=0.80

# ---- Anchor policy: THE consequential setting -----------------------------
#
#   on_flat  (default)  Re-centres on price after a large drift, but ONLY when
#                       no inventory is held. Ranging market: closes out,
#                       re-centres, repeats — runs near continuously. If price
#                       gaps away while holding, the band stays put (that
#                       inventory still needs its exit levels) and the bot
#                       idles until it closes. Keeps the brake.
#
#   session             Anchor is set once from market price on first run and
#                       persisted to bot/state/anchor.json. The band is fixed.
#                       If price leaves it, the bot idles — which is what
#                       stops it buying all the way down a trend.
#
#   manual              Anchor pinned to GRID_ANCHOR_PRICE. Never moves.
#
#   rolling             The band re-centres on price once drift exceeds
#                       GRID_REANCHOR_DRIFT x half-band. Price can never
#                       leave the band, so the bot NEVER idles — and in a
#                       sustained downtrend it averages down indefinitely.
#                       That is how grid bots blow up. Use only with a hard
#                       stop and an exit plan.
#
GRID_ANCHOR_MODE=on_flat

# Required only when GRID_ANCHOR_MODE=manual.
# GRID_ANCHOR_PRICE=65000

# rolling only: re-anchor once price drifts this fraction of the half-band.
# 0.5 with GRID_BAND_PCT=0.15 => re-anchor after a 7.5% move.
GRID_REANCHOR_DRIFT=0.5

# ---- Compounding: when new levels adopt a freshly derived size ------------
#
#   on_flat  (default)  Re-size once grid inventory is fully closed out.
#                       Compounds without ever mixing sizes in the book.
#
#   on_fill             Re-size after any fill that moves size past the
#                       threshold, even while holding inventory. Safe —
#                       closing orders always keep their original quantity
#                       (see counterOrderFor in grid/rebalance.js) — but the
#                       resting book will hold a mix of sizes.
#
#   session             Size is fixed for the life of the process.
#
GRID_RESIZE_MODE=on_flat

# Minimum relative size change worth acting on. Without this, every cent of
# equity movement would cancel and replace the whole resting grid.
GRID_RESIZE_THRESHOLD=0.10

# ---- Exchange notional floor ---------------------------------------------
# Alpaca rejects crypto orders whose COST BASIS is under ~$10, and does NOT
# publish this in the assets endpoint — min_order_size is a quantity
# (0.000015565 BTC, about $1) and clearing it is not sufficient.
#
# The binding case is the cheapest order, at the band's lower bound. With
# $100 equity at 80% allocation across a +/-15% band this caps you at 5
# levels; 20 levels means $3 orders and every one is rejected.
#
# Measured, not assumed: `npm run bot:probe` reads the real number out of
# Alpaca's rejection text. BTC, ETH, LTC and DOGE all returned $10.
MIN_ORDER_NOTIONAL=10

# Per-symbol override, in case floors ever diverge. Takes precedence over
# the value above. Slug is the symbol with punctuation removed, uppercased.
# MIN_ORDER_NOTIONAL_BTCUSD=10
# MIN_ORDER_NOTIONAL_DOGEUSD=10

# ---- Optional absolute pins ----------------------------------------------
# Setting ALL THREE opts out of auto-scaling — the grid will no longer grow
# with the account and you'll be re-setting these by hand. Left unset by
# design; uncomment only if you need one exact band.
# GRID_LOWER_BOUND=55000
# GRID_UPPER_BOUND=75000
# GRID_ORDER_SIZE=0.001

# ─────────────────────────────────────────────────────────────
# RISK
# ─────────────────────────────────────────────────────────────

# Halt trading if the day's loss exceeds this fraction of live equity.
# Scales automatically: 5% of $100 is -$5, 5% of $10k is -$500.
MAX_DAILY_LOSS_PCT=0.05

# Optional hard dollar floor, independent of equity. Whichever stop is
# TIGHTER wins, so this caps the loss a growing balance can tolerate.
# MAX_DAILY_LOSS_USD=-250

# ---- Price stop (opt-in, unset by default) --------------------------------
# Fraction below the band lower bound at which held inventory is cut with a
# market sell. Derived from the band, so it rescales exactly like the bounds:
#   stopPrice = lowerBound x (1 - GRID_STOP_PCT)
#
# This is the counterpart to MAX_DAILY_LOSS_PCT and catches a different
# failure. The daily stop limits how FAST you lose; this limits how FAR one
# position runs against you. With anchor=on_flat a position that never
# recovers idles the bot indefinitely — this converts that into a bounded,
# realized loss, after which the grid is flat and free to re-anchor.
#
# Leave unset to hold stranded inventory instead of realizing the loss.
# GRID_STOP_PCT=0.10

# Note: there is no MAX_POSITION_USD. Worst-case grid notional is checked
# against LIVE buying power from the Alpaca account instead.

# --- Runtime --------------------------------------------------------------

# Master safety switch. Defaults to TRUE even if unset — reconcile() plans
# the book and reports it, but submits nothing. Set to false to trade.
DRY_RUN=true

POLL_INTERVAL_MS=5000
LOG_LEVEL=info

# --- Dashboard API --------------------------------------------------------
API_PORT=4000

# Without a token the API binds 127.0.0.1 only and REFUSES to listen on a
# public interface. Set both of these to expose it to a hosted dashboard.
# API_TOKEN=
# API_HOST=0.0.0.0

# Origin allowed to call the API directly from a browser.
DASHBOARD_ORIGIN=http://localhost:3000
