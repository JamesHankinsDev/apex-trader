# ─────────────────────────────────────────────────────────────
# Apex Trader 2.0 — bot environment template
# Copy to `bot/.env` (or `.env.local`) and fill in.
# NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# --- Alpaca credentials ---------------------------------------------------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# `paper` | `live`. Paper mode forces the paper endpoint no matter what
# ALPACA_BASE_URL says, so going live is a deliberate two-part change.
TRADING_MODE=paper

# ─────────────────────────────────────────────────────────────
# GRID SHAPE
# ─────────────────────────────────────────────────────────────

GRID_SYMBOL=BTC/USD

# Number of levels spanning the band, inclusive of both ends.
GRID_LEVELS=20

# `arithmetic` = equal dollar gaps, `geometric` = equal percentage gaps.
GRID_SPACING=geometric

# ─────────────────────────────────────────────────────────────
# RATIOS — the grid rescales itself from these.
# Bounds and order size are DERIVED from live account state at startup,
# so they grow with the account and follow price. Nothing to re-set by hand.
# ─────────────────────────────────────────────────────────────

# Half-width of the band around the anchor. 0.15 => anchor ±15%.
# Accepts "0.15" or "15%".
GRID_BAND_PCT=0.15

# Fraction of live equity the grid may deploy if EVERY level fills.
# Order size = (equity x this) / (levels x upperBound).
GRID_ALLOCATION_PCT=0.80

# ---- Anchor policy: THE consequential setting -----------------------------
#
#   session  (default)  Anchor is set once from market price on first run and
#                       persisted to bot/state/anchor.json. The band is fixed.
#                       If price leaves it, the bot idles — which is what
#                       stops it buying all the way down a trend.
#
#   manual              Anchor pinned to GRID_ANCHOR_PRICE. Never moves.
#
#   rolling             The band re-centres on price once drift exceeds
#                       GRID_REANCHOR_DRIFT x half-band. Price can never
#                       leave the band, so the bot NEVER idles — and in a
#                       sustained downtrend it averages down indefinitely.
#                       That is how grid bots blow up. Use only with a hard
#                       stop and an exit plan.
#
GRID_ANCHOR_MODE=session

# Required only when GRID_ANCHOR_MODE=manual.
# GRID_ANCHOR_PRICE=65000

# rolling only: re-anchor once price drifts this fraction of the half-band.
# 0.5 with GRID_BAND_PCT=0.15 => re-anchor after a 7.5% move.
GRID_REANCHOR_DRIFT=0.5

# ---- Optional absolute pins ----------------------------------------------
# Setting ALL THREE opts out of auto-scaling — the grid will no longer grow
# with the account and you'll be re-setting these by hand. Left unset by
# design; uncomment only if you need one exact band.
# GRID_LOWER_BOUND=55000
# GRID_UPPER_BOUND=75000
# GRID_ORDER_SIZE=0.001

# ─────────────────────────────────────────────────────────────
# RISK
# ─────────────────────────────────────────────────────────────

# Halt trading if the day's loss exceeds this fraction of live equity.
# Scales automatically: 5% of $100 is -$5, 5% of $10k is -$500.
MAX_DAILY_LOSS_PCT=0.05

# Optional hard dollar floor, independent of equity. Whichever stop is
# TIGHTER wins, so this caps the loss a growing balance can tolerate.
# MAX_DAILY_LOSS_USD=-250

# Note: there is no MAX_POSITION_USD. Worst-case grid notional is checked
# against LIVE buying power from the Alpaca account instead.

# --- Runtime --------------------------------------------------------------
POLL_INTERVAL_MS=5000
LOG_LEVEL=info
API_PORT=4000
