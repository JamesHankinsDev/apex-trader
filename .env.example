## Market data API (used by backtester for fetching bars)
## Alpaca's crypto data API requires LIVE keys even for read-only bar fetches.
ALPACA_API_KEY=your_key
ALPACA_SECRET_KEY=your_secret

## Trading API credentials (used by live runner only)
## Paper trading — safe, no real money. Get from Alpaca paper dashboard.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

## Live trading — REAL MONEY. Only populate when going live after validation.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

## Master safety flag. Even with credentials set, orders are BLOCKED unless
## this is exactly "true". Leave unset or false for dry-run / testing.
TRADING_ENABLED=false
