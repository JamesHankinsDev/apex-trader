# ─────────────────────────────────────────────────────────────
# Apex Trader 2.0 — root environment template
# Copy to `.env` and fill in. NEVER commit the filled-in .env.
# ─────────────────────────────────────────────────────────────

# --- Alpaca credentials ---------------------------------------------------
# Generate at https://app.alpaca.markets/ (use PAPER keys until fully tested)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Paper:  https://paper-api.alpaca.markets
# Live:   https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Crypto market data feed
ALPACA_DATA_URL=https://data.alpaca.markets

# Hard safety switch. `paper` routes all orders to the paper endpoint
# regardless of ALPACA_BASE_URL. Set to `live` only when you mean it.
TRADING_MODE=paper

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Dashboard ------------------------------------------------------------
# Base URL the dashboard uses to reach the bot's API.
NEXT_PUBLIC_API_URL=http://localhost:4000
